# Copy this file to .env for local development. Never commit a real .env file.
# Values intentionally contain no usable credentials.

# Development/test only. The client may use an anon/publishable Supabase key;
# service-role keys belong only in the Supabase secrets store.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-development-anon-key
VITE_VIEWER_BASE_URL=http://localhost:5173

# Viewer deployment: the server-side same-origin proxy appends
# /v1/public/events/{token}. Never expose a service-role key to this route.
SIGNALWORD_PUBLIC_EVENT_ORIGIN=https://your-project.supabase.co/functions/v1/public-event

# Server-side values: configure with `supabase secrets set`, not in this file.
# SUPABASE_URL and SUPABASE_ANON_KEY are injected by the Edge Runtime.
# APP_ENV=development
# DELIVERY_PROVIDER=fake
# DELIVERY_PAYLOAD_KEY=replace-with-32-random-bytes-as-base64url
# DELIVERY_PAYLOAD_KEY_VERSION=1
# DESTINATION_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64url
# DESTINATION_FINGERPRINT_KEY=replace-with-a-different-32-byte-base64url-key
# DESTINATION_KEY_VERSION=1
# MESSAGE_PROVIDER_API_KEY=
# MESSAGE_PROVIDER_WEBHOOK_SECRET=
