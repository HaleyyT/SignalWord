{
  "name": "signalword",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A privacy-first personal safety alert system.",
  "workspaces": [
    "apps/viewer"
  ],
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "check": "node scripts/verify-repository.mjs && node scripts/verify-contracts.mjs && node scripts/security-audit.mjs",
    "day1:preflight": "node scripts/day1-preflight.mjs",
    "day1:preflight:strict": "node scripts/day1-preflight.mjs --strict",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:db": "npx supabase test db",
    "test": "node --test tests/*.test.mjs && npm run test --workspace=@signalword/viewer",
    "test:functions": "node --test tests/functions.test.mjs",
    "build": "npm run build --workspace=@signalword/viewer",
    "verify": "npm run check && npm run test && npm run build"
  },
  "devDependencies": {
    "supabase": "2.117.0"
  }
}
