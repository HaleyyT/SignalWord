{
  "rewrites": [
    { "source": "/events/:token", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/support", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
